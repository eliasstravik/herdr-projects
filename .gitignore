# The map of which file holds what: made in your own folder (herdr-projects docs), never committed.
docs/where-things-live.md
/target/
/examples/
# The program bin/run.sh (bin/run.ps1 on Windows: bin/run.exe) downloads for this platform, with its version and its
# download lock.
/bin/herdr-projects-*
/bin/.herdr-projects-*
/bin/run.exe*
