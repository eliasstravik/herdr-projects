#!/usr/bin/perl
# The shepherdr command on a machine Shepherdr runs from the main one: it sends its words to Shepherdr through the
# SSH tunnel the main machine keeps open to this folder (main.sock) and prints the answer. Put here by Shepherdr.
use strict;
use warnings;
use Cwd ();
use File::Basename ();
use File::Spec ();
use IO::Socket::UNIX;
use Encode ();
use JSON::PP;

my $dir = File::Basename::dirname(Cwd::abs_path($0));
my $sock = "$dir/../main.sock";
my $stdin;
# shepherdr secret run NAME … -- <command>: only the names go to Shepherdr; the command runs here, with the values in
# its environment. shepherdr secret env writes them to a file here. Neither prints a value (as server/cli.ts)
my $secret = @ARGV && $ARGV[0] eq 'secret' ? ($ARGV[1] // '') : '';
my @args = @ARGV;
my @command;
if ($secret eq 'run') {
  my ($cut) = grep { $ARGV[$_] eq '--' } 0 .. $#ARGV;
  if (defined $cut && $cut > 0) { @args = @ARGV[0 .. $cut - 1]; @command = @ARGV[$cut + 1 .. $#ARGV]; }
  unless (@command) { print STDERR "Put the command after --: shepherdr secret run NAME [NAME …] -- <command> [its words]\n"; exit 1; }
}
# the words that take a text on stdin: a secret to keep, a new HEARTBEAT.md (never secret run's: that is its command's)
if (@args && (($secret eq 'set' || $secret eq 'elevenlabs') || ($args[0] eq 'heartbeat' && ($args[1] // '') eq 'set')) && !-t STDIN) { local $/; $stdin = <STDIN>; }
my $u = sub { Encode::decode('UTF-8', $_[0]) };
my %body = (args => [map { $u->($_) } @args], cwd => $u->(Cwd::getcwd()));
$body{chat} = $u->($ENV{SHEPHERDR_CHAT}) if $ENV{SHEPHERDR_CHAT};
$body{stdin} = $u->($stdin) if defined $stdin;
my $json = JSON::PP->new->utf8->canonical->encode(\%body);
my $s = IO::Socket::UNIX->new(Type => SOCK_STREAM(), Peer => $sock);
unless ($s) {
  print STDERR "Shepherdr can't be reached from this machine right now (its link from the main machine is down). Check the machine in Shepherdr, or run shepherdr doctor on the main machine.\n";
  exit 2;
}
print $s "POST /api/cli HTTP/1.0\r\nHost: shepherdr\r\nContent-Type: application/json\r\nContent-Length: " . length($json) . "\r\n\r\n$json";
# shepherdr merge answers within 90 s: no answer a little after that means none is coming (Shepherdr restarted, or the
# tunnel dropped and left this end open), never a wait on and on. The same words as server/cli.ts's
my $merge = @ARGV && ($ARGV[0] eq 'merge' || ($ARGV[0] eq 'task' && ($ARGV[1] // '') eq 'merge'));
my $wait = $merge ? ($ENV{SHEPHERDR_MERGE_WAIT} // 110000) : 0;
my $res = eval {
  local $SIG{ALRM} = sub { die "no answer\n" };
  alarm(int(($wait + 999) / 1000)) if $wait;
  my $r = do { local $/; <$s> };
  alarm(0);
  $r;
};
close $s;
unless (defined $res || !$merge) {
  my $id = ($ARGV[0] eq 'merge' ? $ARGV[1] : $ARGV[2]) // '<id>';
  my $secs = int(($wait + 999) / 1000);
  print STDERR "shepherdr merge $id got no answer from Shepherdr in $secs s (it may have restarted). Don't leave it running: see where it is with shepherdr task show $id, and unless it says Merged, run shepherdr merge $id again; it finishes the merge, or says it is merged.\n";
  exit 1;
}
my ($head, $resp) = split /\r\n\r\n/, $res // '', 2;
my $j = eval { JSON::PP->new->utf8->decode($resp // '') };
unless ($j) {
  print STDERR "Shepherdr gave no answer.\n";
  exit 2;
}
if ($j->{secrets} && $secret eq 'run') {
  $ENV{$_} = Encode::encode('UTF-8', $j->{secrets}{$_}) for keys %{ $j->{secrets} };
  exec { $command[0] } @command or do { print STDERR "Couldn't run $command[0]: $!\n"; exit 127; };
}
if ($j->{secrets} && $secret eq 'env') {
  my ($out, $code) = env_file($j->{secrets});
  print $out;
  exit $code;
}
binmode STDOUT, ':utf8';
print $j->{out} // '';
exit($j->{code} // 0);

# shepherdr secret env: each NAME=value in the file (--file, .env by default), in place of its old line, the file
# readable by you only; refused where git would keep it
sub env_file {
  my ($secrets) = @_;
  my $name = '.env';
  for my $i (0 .. $#args) {
    if ($args[$i] =~ /^--file=(.*)$/) { $name = $1 }
    elsif ($args[$i] eq '--file') { $name = $args[$i + 1] // '' }
  }
  return ("shepherdr secret env NAME [NAME …] [--file .env]\n", 1) unless length $name;
  my $file = File::Spec->rel2abs($name);
  my $dir = File::Basename::dirname($file);
  # git, quietly: did it say yes
  my $git = sub {
    my $pid = fork() // return 0;
    unless ($pid) { open(STDOUT, '>', '/dev/null'); open(STDERR, '>', '/dev/null'); exec('git', '-C', $dir, @_) or exit 127; }
    waitpid($pid, 0);
    return $? == 0;
  };
  my $tracked = $git->('rev-parse', '--is-inside-work-tree') && !$git->('check-ignore', '-q', $file);
  return ("$name is not ignored by git: add it to .gitignore first, so the secret never lands in git.\n", 1) if $tracked;
  my @names = sort keys %$secrets;
  my @old;
  if (open(my $in, '<', $file)) {
    for my $l (<$in>) {
      chomp $l;
      push @old, $l unless grep { $l =~ /^\s*(export\s+)?\Q$_\E\s*=/ } @names;
    }
    close $in;
  }
  my $old = umask(077);
  open(my $out, '>', $file) or do { umask($old); return ("Couldn't write $name: $!\n", 1) };
  umask($old);
  binmode $out, ':utf8';
  print $out join("\n", @old, map { "$_=" . env_value($secrets->{$_}) } @names) . "\n";
  close $out;
  chmod 0600, $file;
  return ("Wrote " . join(', ', @names) . " to $name (readable by you only; git ignores it). Never print or commit it.\n", 0);
}

# a value as a .env file holds it: as it is, in single quotes (nothing in it is read), or in double quotes
sub env_value {
  my ($v) = @_;
  return $v if $v =~ /^[\w@%+:,.\/-]*$/;
  return "'$v'" unless $v =~ /['\n\r]/;
  $v =~ s/\\/\\\\/g; $v =~ s/"/\\"/g; $v =~ s/\$/\\\$/g; $v =~ s/\n/\\n/g; $v =~ s/\r/\\r/g;
  return "\"$v\"";
}
